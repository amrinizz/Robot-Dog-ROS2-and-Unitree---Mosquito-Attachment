from flask import Flask, Response, send_from_directory
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import Image
from cv_bridge import CvBridge
import cv2
import threading
import os
import time

# Initialize Flask app
app = Flask(__name__)
web_folder = os.path.join(os.path.dirname(os.path.abspath(__file__)), "web")

# Global shared frame
latest_frame = None
lock = threading.Lock()

# ROS2 subscriber node
class ImageSubscriber(Node):
    def __init__(self):
        super().__init__('image_subscriber')
        self.bridge = CvBridge()
        self.subscription = self.create_subscription(
            Image,
            '/front_camera/image_raw',
            self.listener_callback,
            10
        )

    def listener_callback(self, msg):
        global latest_frame
        frame = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
        with lock:
            latest_frame = frame

# MJPEG generator
def generate_stream():
    global latest_frame
    while True:
        with lock:
            if latest_frame is not None:
                ret, buffer = cv2.imencode('.jpg', latest_frame)
                if ret:
                    frame = buffer.tobytes()
                    yield (b'--frame\r\n'
                           b'Content-Type: image/jpeg\r\n\r\n' + frame + b'\r\n')
        time.sleep(0.03)  # about 30 FPS

# Serve index.html from "web" folder
@app.route('/')
def serve_index():
    return send_from_directory(web_folder, 'index.html')

# Serve other static files (CSS, JS, etc.)
@app.route('/<path:path>')
def serve_static(path):
    return send_from_directory(web_folder, path)

# Stream video to browser
@app.route('/video')
def video_feed():
    return Response(generate_stream(),
                    mimetype='multipart/x-mixed-replace; boundary=frame')

def ros_spin(node):
    rclpy.spin(node)

if __name__ == '__main__':
    # Init ROS in background thread
    rclpy.init()
    image_node = ImageSubscriber()
    ros_thread = threading.Thread(target=ros_spin, args=(image_node,), daemon=True)
    ros_thread.start()

    print(f"Serving web app from: {web_folder}")
    app.run(host='0.0.0.0', port=8080, threaded=True)
